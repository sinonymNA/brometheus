# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
# Get these from https://app.alpaca.markets → Paper Trading → API Keys

# Your Alpaca API key ID
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXXXXXX

# Your Alpaca secret key (shown only once on creation)
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paper trading endpoint — do NOT change this to the live URL unless you
# intend to trade with real money
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Database ──────────────────────────────────────────────────────────────────
# On Railway: copy the DATABASE_URL from the PostgreSQL service's
# "Connect" tab after adding the service to your project.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/apexcrusher

# ── Redis ─────────────────────────────────────────────────────────────────────
# On Railway: copy the REDIS_URL from the Redis service's "Connect" tab.
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:password@localhost:6379

# ── Notifications (optional) ──────────────────────────────────────────────────
# Create a webhook in your Discord server:
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
# Leave blank to disable Discord alerts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxx
